NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Pollux chat widget (see components/PolluxChatWidget.tsx) ---

# Letta Cloud API key. Server-side only: never prefix with NEXT_PUBLIC_, never
# commit the real value.
LETTA_API_KEY=your-key-here

# Chris's existing "Pollux" agent. Its memory already holds his profile,
# humor rule, and strict-facts rule. Do not point this at a different agent.
LETTA_CHAT_AGENT_ID=agent-adc90455-be7e-4f23-b0fd-beefa02967e6

# Tools this chat may run when the agent asks for approval, comma separated.
# Use * for every tool. Left empty by default: a public, unauthenticated
# widget is not the place to auto-approve tool calls.
LETTA_AUTO_APPROVE_TOOLS=

# Signs the per-visitor identity cookie that authenticates chat requests and
# scopes each visitor to their own conversation. Generate one with:
#   openssl rand -hex 32
# Required: requests are refused rather than falling back to unsigned
# (forgeable) cookies.
POLLUX_COOKIE_SECRET=

# Optional rate-limit tuning. Defaults shown; uncomment to change.
# POLLUX_CHAT_RATE_LIMIT=20
# POLLUX_CHAT_RATE_WINDOW_MS=600000
# POLLUX_CHAT_IP_RATE_LIMIT=60

# --- News section (see components/News.tsx, lib/news.ts) ---

# webz.io API token. Server-side only: never prefix with NEXT_PUBLIC_, never
# commit the real value. Without it, the News section just renders nothing.
WEBZIO_API_TOKEN=your-webzio-token-here
